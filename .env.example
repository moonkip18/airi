# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_PROXY=

# LLM: any OpenAI-compatible endpoint works — OpenAI, Groq, OpenRouter, a
# local llama.cpp/LM Studio/Ollama server, or any commercial gateway.
# Point LLM_BASE_URL at the provider and set a model id it serves.
#
# Recommended (good at casual, personality-driven chat, cheap enough to run
# a chatty bot all day):
#   OpenAI:     gpt-4o-mini    base_url https://api.openai.com/v1
#   Groq:       llama-3.3-70b-versatile   base_url https://api.groq.com/openai/v1
#   OpenRouter: meta-llama/llama-3.3-70b-instruct  base_url https://openrouter.ai/api/v1
#   Local:      whatever your server exposes (e.g. qwen2.5:14b via Ollama,
#               base_url http://127.0.0.1:11434/v1)
#
# Bigger/stronger models (gpt-4o, claude, gemini) also work but are rarely
# worth it for casual chat; smaller ones (<7B) tend to slip into
# assistant-speak, which the validator will filter but at a cost.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Canonical relationship: the Telegram user id of the person Airi treats as
# her closest one (optional; no label is shown anywhere — she just treats
# them differently)
AIRI_ANCHOR_USER_ID=

# Database Configuration
DATABASE_URL=sqlite:///data/agent.db

# Embedding Model (sentence-transformers; falls back to a light local backend if unavailable)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Conversation Settings
MAX_CONTEXT_MESSAGES=50
MAX_MEMORY_RESULTS=8
MEMORY_IMPORTANCE_THRESHOLD=0.25

# Response Timing (seconds)
MIN_RESPONSE_DELAY=0.4
MAX_RESPONSE_DELAY=8.0
DIRECT_MENTION_DELAY=0.5
AUTONOMOUS_RESPONSE_DELAY=3.0

# Personality dial (state-driven liveliness without fine-tuning).
# Temperature is modulated by her emotional state: amused/bored/competitive
# moments sample hotter, annoyed/embarrassed moments sample cooler.
DECISION_TEMPERATURE_BASE=0.5
DECISION_TEMPERATURE_MAX=0.8
# When the validator hard-blocks a reply (AI filler), the chance she answers
# with a short meta-line ("filtered") instead of vanishing silently.
FILTERED_REPLY_PROBABILITY=0.25
# Persist her replies + context snapshots to training_samples for a future
# personality fine-tune / prompt distillation. No LLM cost.
TRAINING_SAMPLE_LOGGING=true

# Autonomous Behavior
AUTONOMOUS_BEHAVIOR_ENABLED=true
AUTONOMOUS_CHECK_INTERVAL=30.0
AUTONOMOUS_PARTICIPATION_THRESHOLD=0.65
MAX_INITIATIONS_PER_HOUR=3

# Social Behavior
MAX_MESSAGES_PER_MINUTE=5
CONVERSATION_SATURATION_THRESHOLD=10
TOPIC_DRIFT_THRESHOLD=0.4

# Working Memory (short-term social situation; auto-expiring)
WORKING_MEMORY_EXPIRY_MINUTES=120
WORKING_MEMORY_MAX_ENTRIES=60
WORKING_MEMORY_TOPIC_HISTORY=6

# Attention
ATTENTION_DIRECT_MENTION=0.5
ATTENTION_INTEREST_BONUS=0.35
ATTENTION_PARTICIPATION_THRESHOLD=0.55

# Evolving Topic Interests (gradual, learned)
TOPIC_INTEREST_DELTA=0.06
TOPIC_INTEREST_MAX=1.0
TOPIC_INTEREST_MIN=0.0

# Boredom (stateful)
BOREDOM_THRESHOLD=0.6
BOREDOM_LEAVE_THRESHOLD=0.8
BOREDOM_DECAY_RATE=0.01

# Memory maintenance (decay / reinforcement / consolidation)
MEMORY_MAINTENANCE_INTERVAL=900
MEMORY_REINFORCEMENT_THRESHOLD=0.9
MEMORY_CONSOLIDATION_INTERVAL=3600

# Delayed actions
DELAYED_ACTION_INTERVAL=15.0

# Response validation / anti-repetition
MAX_RESPONSE_CHARS=400
# Casual-chat length gate: replies longer than this get trimmed to their
# leading sentences unless the whole room is writing paragraphs. 0 disables.
CASUAL_MAX_CHARS=140
ANTI_REPETITION_WINDOW=40

# Emotional State
EMOTION_DECAY_RATE=0.02
MOOD_CHANGE_SENSITIVITY=0.15

# Ping fatigue: humans get briefly tired of one person spamming them.
IRRITATION_WINDOW_SECONDS=90
IRRITATION_INCREMENT=0.34
IRRITATION_DECAY_PER_HOUR=0.6
IRRITATION_MAX=3.0

# Memory callbacks: resurface old memories when genuinely relevant.
CALLBACK_MIN_AGE_DAYS=2
CALLBACK_REFRACTORY_DAYS=3
CALLBACK_MIN_RELEVANCE=0.3

# Late message self-edits: she notices her typo 30-120s later and fixes it.
LATE_TYPO_FIX_CHANCE=0.35
LATE_TYPO_FIX_MIN_SECONDS=25
LATE_TYPO_FIX_MAX_SECONDS=120

# Weekly self-style audit: her own drift, measured from her messages.
STYLE_AUDIT_INTERVAL_SECONDS=604800
STYLE_AUDIT_FIRST_DELAY_SECONDS=900
STYLE_AUDIT_WINDOW_DAYS=7

# Memory
MEMORY_EXTRACTION_INTERVAL=180
MAX_MEMORIES_PER_EXTRACTION=5
MEMORY_SIMILARITY_THRESHOLD=0.75

# Language Behavior (Airi: English default, Persian rare + deliberate)
DEFAULT_OUTPUT_LANGUAGE=english
PERSIAN_SNIPPET_PROBABILITY=0.15
PERSIAN_AMUSEMENT_THRESHOLD=0.75
PERSIAN_AFFECTION_THRESHOLD=0.4
PERSIAN_CURIOSITY_THRESHOLD=0.8

# Learning Loop / Self-Development
LEARNING_LOOP_INTERVAL=360
OBSESSION_ENGAGEMENT_THRESHOLD=6.0
MAX_OBSESSIONS=5
JEALOUSY_DECAY_RATE=0.05

# Conversation lifecycle
RETURN_COOLDOWN_SECONDS=1800

# Access control: comma-separated Telegram chat ids. When set, the bot ONLY
# works in these chats (groups AND private) — everything else is ignored with
# zero API cost. Leave empty to allow all. Group ids are negative numbers;
# the bot logs them for you when it sees a chat ("chat_ignored_not_allowed").
ALLOWED_CHAT_IDS=

# Logging
DEBUG_MODE=false
LOG_LEVEL=INFO
LOG_FORMAT=pretty
VERBOSE_DEBUG=false

# Disable the model's internal thinking phase (big speed + token savings).
LLM_DISABLE_THINKING=true
# Hard ceiling on one HTTP attempt to the LLM gateway (a hung call must not
# hold a chat's lock for minutes). Set to 0 for no timeout.
LLM_TIMEOUT_SECONDS=90
# SDK-internal retries for transient errors (429/5xx/network).
LLM_MAX_RETRIES=1

# --- Human imperfection dial (all state-driven; see app/social/style.py) ---
# Chance to re-roll the verbosity streak mid-streak (0.1 = mostly stable).
TYPING_REGISTER_ROLL_CHANCE=0.10
# Base per-message typo chance before mood modifiers (energy doubles it,
# low energy halves it).
TYPO_CHANCE_BASE=0.06
# Chance she actually fixes a typo she made (the rest stay standing —
# people leave typos behind).
TYPO_CORRECTION_CHANCE=0.55
# Double-text window: a small follow-up fires 20-45s later, only if the
# chat stayed quiet after her message.
DOUBLE_TEXT_MIN_SECONDS=20
DOUBLE_TEXT_MAX_SECONDS=45
# Bleep hard profanity in outgoing messages with [filtered] (streamer style).
# She still types the actual words; mild swears pass through.
PROFANITY_FILTER=true





